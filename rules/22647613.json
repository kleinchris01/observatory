              "type": "jira.issue.outgoing.webhook",
              "value": {
                "contentType": "custom",
                "continueOnErrorEnabled": true,
                "customBody": "{\n  \"query\": \"mutation InviteUsersToTeam($email: String!, $teamid: ID!, $role: UserRole) {\\n  accountsInviteUsersToTeam(\\n    input: {\\n      # Identifies the team that you want to invite the users to\\n      teamId: $teamid\\n      # The email addresses that you want to invite to the team\\n      emailAddresses: [$email]\\n      # The role on the team that you want the invited users to assume\\n      # This is optional, and will default to the SUPPLY_CHAIN role\\n      forRole: $role\\n    }\\n  ) {\\n    # Optional query with the invites that were created/accepted\\n    results {\\n      # If the user didn't already request to be on the team, a team invite is now created for the user\\n      ... on TeamInviteEdge {\\n          node {\\n            # The user that was invited\\n            user {\\n              # If the invited email already existed on LightSource as a user\\n              ... on LightSourceUser {\\n                 id\\n                 emailAddress\\n              }\\n              # If the invited email didn't already exist on LightSource\\n              ... on InvitedUser {\\n                 email\\n              }\\n            }\\n          }\\n }\\n      # If a user already requested to be on the team, then sending the invite will automatically accept their request\\n      ... on JoinTeamRequestEdge {\\n        node {\\n          requestingUser {\\n             display\\n             emailAddress\\n   }\\n }\\n      }\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"email\": \"{{mail}}\",\n    \"teamid\": \"A_2UPJdHw4-x5g\",\n    \"role\": \"SUPPLY_CHAIN\"\n  }\n}\n",
                "headers": [
                  {
                    "headerSecure": false,
                    "id": "_header_1709764656883",
                    "name": "Origin",
                    "value": "https://lightsource.ai"
                  },
                  {
                    "headerSecure": false,
                    "id": "_header_1709766215928",
                    "name": "Authorization",
                    "value": "Bearer [[REDACTED:e1cc3a74]]"
                  },
                  {
                    "headerSecure": false,
                    "id": "_header_1731454908915",
                    "name": "",
                    "value": ""
                  }
                ],
                "method": "POST",
                "responseEnabled": true,
                "sendIssue": false,
                "url": "https://api.lightsource.ai/graphql",
                "urlSecure": false
              }
            },

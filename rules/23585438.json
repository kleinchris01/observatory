        "sendGroupedEmails": true,
        "templateContextData": {
          "body": "<html>\n<body>\n<p>Hi,</p>\n<p>Here's the latest open items for the WBS budget setup (sub-tasks in status \"WORK IN PROGRESS\").</p>\n<p>Jira Dashboard: https://ford-advev.atlassian.net/jira/dashboards/11348</p>\n<p>Please update the sub-task status to \"DONE\" when complete.</p>\n\n<table border=\"1\" cellpadding=\"5\" cellspacing=\"0\">\n<tr>\n  <th>Sub-Task Key</th>\n  <th>Parent Issue</th>\n  <th>Parent Summary</th>\n  <th>ADVEV Vehicle Program</th>\n  <th>SIT/Attribute</th>\n  <th>Total Vendor Tooling Cost</th>\n  <th>Suppliers</th>\n  <th>Supplier Location</th>\n  <th>Part Number</th>\n  <th>GPID</th>\n  <th>Reporter</th>\n  <th>Engineer</th>\n  <th>Buyer</th>\n  <th>GSM</th>\n  <th>Sub-Task Last Comment</th>\n</tr>\n{{#lookupIssues}}\n<tr>\n  <td><a href=\"https://ford-advev.atlassian.net/browse/{{key}}\">{{key}}</a></td>\n  <td><a href=\"https://ford-advev.atlassian.net/browse/{{parent.key}}\">{{parent.key}}</a></td>\n  <td>{{parent.summary}}</td>\n  <td>{{parent.customfield_11104}}</td>\n  <td>{{parent.customfield_11492}}</td>\n  <td>{{parent.customfield_12889}}</td>\n  <td>{{parent.customfield_12143}}</td>\n  <td>{{parent.customfield_12891}}</td>\n  <td>{{parent.customfield_11825}}</td>\n  <td>{{parent.customfield_12486}}</td>\n  <td>{{parent.reporter.displayName}}</td>\n  <td>{{parent.customfield_10978.displayName}}</td>\n  <td>{{parent.customfield_11189.displayName}}</td>\n  <td>{{parent.customfield_12893.displayName}}</td>\n  <td>{{comment.0.body}}</td>\n</tr>\n{{/lookupIssues}}\n</table>\n\n<p>This is a 1/day Jira automation.</p>\n<p>For any questions please reach out to Sam Wocks.</p>\n</body>\n</html>\n",
          "bodyType": "HTML",

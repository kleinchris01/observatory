              "schemaVersion": 2,
              "type": "jira.issue.comment",
              "value": {
                "addCommentOnce": true,
                "comment": "Next Steps / Comments\n- The Engineer/TPM is responsible to provide all info that's above the \"Description\" on the left side. This info is needed in order to streamline issuing the budget and issuing PO's in iERP.\n- The general finance strategy is to issue ≤80% of the TOTAL amount initially. The rationale is that by initially committing to less than the full amount, we create an opportunity to potentially reduce our overall expenses. When we commit 100% upfront, we eliminate any possibility of cost savings. \n\nPlease reach out to Sam Wocks for any questions",
                "commentVisibility": null,
                "publicComment": false,
                "sendNotifications": true
              }
            }

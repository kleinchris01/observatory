                "legacyConfig": true,
                "sendGroupedEmails": true,
                "templateContextData": {
                  "body": "Congrats, your Vendor Tooling Finance (FIN) request was successfully submitted!\n\nSummary: {{issue.summary}}\nLink: https://ford-advev.atlassian.net/browse/{{issue.key}}\n\nNext Steps:\n- In the link above, please see sub-task #1 to see the information that's needed in Jira in order to proceed (needed to setup the Material Masters and WBS budget in backend systems)\n- Please use the sub-task \"PARTIAL Funding Request #1\" to enter in the funding that's needed today, which should be <= the \"Total Vendor Tooling Cost\" amount. This will us finance track spending easier for your part.\n\n*Future Next Steps \n--> for your 2nd PARIAL Funding Request, or any questions, please reach out to @Samuel-Wocks ",
                  "bodyType": "HTML",
                  "emailName": "Chintala",
                  "fromEmailAddress": "automation@ford-advev.atlassian.net",
                  "fromName": "Jira automation",
                  "subject": "Issue {{issue.summary}} Created!"
                },

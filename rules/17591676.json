        "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Your Shipment Has Arrived!</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            background-color: #E7EBEE;\n        }\n        .container {\n            width: 100%;\n            max-width: 600px;\n            margin: 40px auto;\n            background-color: #ffffff;\n            border-radius: 8px;\n            overflow: hidden;\n            border: 1px solid #dddddd;\n        }\n        .header {\n            background-color: #003399; /* Dark blue background */\n            color: #ffffff;\n            padding: 20px;\n            text-align: center;\n        }\n        .header h1 {\n            margin: 0;\n            font-size: 24px;\n        }\n        .body {\n            padding: 20px;\n            background-color: #ffffff; /* White background for the body */\n            color: #000000;\n        }\n        .body h2 {\n            color: #003399; /* Dark blue text for 'Hello' */\n        }\n        .details {\n            background-color: #f0f0f0; /* Light gray background for details */\n            padding: 15px;\n            margin-top: 25px;\n        }\n        .details p {\n            margin-bottom: 10px;\n        }\n        .cta {\n            background-color: #FF0000; /* Red background for CTA */\n            color: #ffffff;\n            display: inline-block;\n            padding: 10px 15px;\n            margin: 25px auto;\n            text-decoration: none;\n            border-radius: 5px;\n            font-weight: bold;\n        }\n        .footer {\n            background-color: #003399; /* Dark blue background */\n            color: #ffffff;\n            text-align: center;\n            padding: 10px;\n            font-size: 12px;\n        }\n        @media (max-width: 600px) {\n            .container {\n                width: 95%;\n                margin: 20px auto;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>🚚 Your Shipment Has Arrived!</h1>\n        </div>\n        <div class=\"body\">\n            <h2>Hello,</h2>\n            <p>Your recent purchase request, <strong>{{issue.key}}</strong>, has been successfully delivered to <strong>{{issue.Shipping Address}}</strong> on <strong>{{now.shortDate}}</strong>.</p>\n            <div class=\"details\">\n                <p><strong>Summary:</strong> {{issue.summary}}</p>\n                <p><strong>Vendor:</strong> {{issue.Vendor}}</p>\n                <p><strong>Purchase Cost:</strong> {{issue.Purchase Cost}}</p>\n                <p><strong>Confirmation Code:</strong> {{issue.Confirmation Code}}</p>\n                <p><strong>Tracking Number:</strong> {{issue.Tracking Number}}</p>\n                <p><strong>Description:</strong> {{issue.Description}}</p>\n            </div>\n            <a href=\"mailto:fabpurchasing@example.com\" class=\"cta\">Contact FAB Purchasing</a>\n        </div>\n        <div class=\"footer\">\n            <p>© 2024 Your Company. All rights reserved.</p>\n        </div>\n    </div>\n</body>\n</html>\n",

{
  "name": "custom-field-governance-macro",
  "private": true,
  "version": "0.1.1",
  "description": "Forge Confluence macro for Jira custom field governance",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode admin",
    "build:macro": "vite build",
    "build:admin": "vite build --mode admin",
    "dev": "vite",
    "lint": "forge lint",
    "test": "vitest run",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rules:snapshot": "node scripts/snapshot-rules.mjs",
    "deploy": "npm run build && forge deploy",
    "deploy:dev": "npm run build && forge deploy",
    "deploy:staging": "npm run test && npm run build && forge deploy --environment staging",
    "deploy:production": "npm run test && npm run build && forge deploy --environment production",
    "forge:install": "forge install",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@forge/api": "^6.1.1",
    "@forge/bridge": "^5.17.0",
    "@forge/events": "^2.0.0",
    "@forge/kvs": "^1.6.5",
    "@forge/metrics": "^0.3.29",
    "@forge/resolver": "^1.7.0",
    "@forge/sql": "^3.0.26",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
